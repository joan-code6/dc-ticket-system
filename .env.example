# Discord bot token (required)
DC_TOKEN=your-bot-token-here

# OpenRouter key for AI features (optional)
HC_AI_API_KEY=

# Database encryption key (required). The ticket database is encrypted at
# rest with SQLCipher; the bot refuses to start without this key.
# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
#   # or: openssl rand -base64 32
# Keep a safe copy - losing this key means losing access to the database.
DB_ENCRYPTION_KEY=
